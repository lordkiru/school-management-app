# ─── Required ─────────────────────────────────────────────────────────────────

# MongoDB Connection
MONGO_URI=your_mongodb_connection_string_here

# JWT Secret — must be at least 64 random characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_characters

# ─── Payments ─────────────────────────────────────────────────────────────────

# Paystack API Key (sk_live_... for production, sk_test_... for testing)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# ─── File Uploads (Cloudinary) ────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Error Tracking (optional but recommended in production) ──────────────────

SENTRY_DSN=your_sentry_dsn_here

# ─── Server ───────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://app.yourschool.com,https://yourschool.com

# ─── Frontend URL (used for password reset links) ─────────────────────────────

# Development:
FRONTEND_URL=http://localhost:5173
# Production example:
# FRONTEND_URL=https://app.yourschool.com

# ─── Email (for password reset emails) ───────────────────────────────────────
# Gmail setup:
#   1. Enable 2-Step Verification at myaccount.google.com
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an app password named "Lemida School App"
#   4. Use that 16-char password as EMAIL_PASS (no spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your16characterapppassword
EMAIL_FROM=Lemida School App <you@gmail.com>
